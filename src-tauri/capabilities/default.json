{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: its app commands (including the terminal sessions), the file dialog for Choose binary, writing text to the clipboard, and the browser for exactly one URL (herdr.dev)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "allow-answer-machine-setup",
    "allow-cancel-machine-setup",
    "allow-clear-ended",
    "allow-close-terminal",
    "allow-copy-attach-command",
    "allow-create-session",
    "allow-get-command-log",
    "allow-get-settings",
    "allow-get-state",
    "allow-get-terminals",
    "allow-interrupt-terminal",
    "allow-list-agent-kinds",
    "allow-list-ssh-hosts",
    "allow-machine-add-argv",
    "allow-machine-remove",
    "allow-machine-rename",
    "allow-machine-status",
    "allow-mark-seen",
    "allow-mark-unread",
    "allow-open-in-terminal",
    "allow-open-session",
    "allow-open-settings",
    "allow-preview-machine-add",
    "allow-preview-new-session",
    "allow-preview-reconnect",
    "allow-read-tail",
    "allow-refresh-now",
    "allow-remove-terminal",
    "allow-reply-to-agent",
    "allow-set-keep",
    "allow-set-pinned",
    "allow-set-settings",
    "allow-set-visible-row",
    "allow-start-machine-add",
    "allow-start-preview",
    "allow-stop-preview",
    "allow-term-close",
    "allow-term-open",
    "allow-term-resize",
    "allow-term-write",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://herdr.dev"
        },
        {
          "url": "https://herdr.dev/"
        }
      ]
    }
  ]
}
