{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: the file dialog for Choose binary, and the browser for exactly one URL (herdr.dev)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://herdr.dev" }, { "url": "https://herdr.dev/" }]
    }
  ]
}
